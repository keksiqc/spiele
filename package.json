{
  "name": "spiele",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "A two-player association game running on Nuxt and Cloudflare Workers.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt build && wrangler dev",
    "preview:nuxt": "nuxt preview",
    "deploy": "nuxt build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "postinstall": "nuxt prepare && lefthook install"
  },
  "dependencies": {
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.1.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  }
}
