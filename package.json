{
  "name": "spiele",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "description": "A two-player association game built with Nuxt and Nitro WebSockets.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt build && wrangler dev",
    "generate": "nuxt generate",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "cf:types": "wrangler types",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check": "x18n check",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "nuxt build && vitest run test/rooms.integration.test.ts",
    "prepare": "nuxt prepare && lefthook install && skills experimental_sync -a universal -y && wrangler types"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@antfu/skills": "^0.1.2",
    "@iconify-json/lucide": "^1.2.148",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vueuse/core": "^15.0.0",
    "@x18n/cli": "^0.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "lefthook": "^2.2.2",
    "nuxt": "^4.6.3",
    "nuxt-i18n-micro": "^3.30.1",
    "skills": "^1.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.154.0"
  }
}
